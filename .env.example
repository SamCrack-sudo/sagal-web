# ───────────────────────────────────────────────────────────────────────────
# Variables de entorno de SAGAL Robotics
#
# Copia este archivo como `.env` para desarrollo local (o `.dev.vars` si usas
# `wrangler dev`). En producción se definen en Cloudflare:
#   Workers & Pages → tu proyecto → Settings → Variables and Secrets.
#
# TODAS son opcionales. Si falta alguna, el sitio sigue compilando y funcionando
# en MODO DEMO: los formularios responden con un aviso de demostración y no se
# envían correos. NUNCA subas un `.env` con claves reales: el repositorio es público.
# ───────────────────────────────────────────────────────────────────────────

# URL pública del sitio, sin barra final. Se usa en el sitemap, las URL canónicas
# y las imágenes Open Graph. Ej.: https://www.sagalrobotics.co
PUBLIC_SITE_URL=

# ── Antispam: Cloudflare Turnstile ─────────────────────────────────────────
# Dashboard de Cloudflare → Turnstile → Add widget. La clave de sitio es pública;
# la secreta solo va en el servidor.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Correos transaccionales: Resend ────────────────────────────────────────
# resend.com → API Keys. Mientras no verifiques tu dominio puedes usar
# "SAGAL Robotics <onboarding@resend.dev>" como remitente (solo entrega al
# correo de la cuenta de Resend).
RESEND_API_KEY=
RESEND_FROM="SAGAL Robotics <cotizaciones@tu-dominio.co>"
# Correo que recibe los avisos de nuevas cotizaciones y solicitudes.
# Si se deja vacío se usa el correo de contacto de src/config/marca.ts.
OWNER_EMAIL=

# ── Analítica (apagada por defecto) ────────────────────────────────────────
# Valores: ninguno | ga4 | plausible
PUBLIC_ANALYTICS_PROVIDER=ninguno
# GA4: el ID de medición (G-XXXXXXX). Plausible: el dominio registrado.
PUBLIC_ANALYTICS_ID=

# ── Fase 2 (aún no se usan) ────────────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAILS=sagalrobotics@gmail.com
