---
/**
 * Layout base del sitio público: metadatos SEO, Open Graph, datos estructurados,
 * encabezado, pie, botón de WhatsApp contextual y analítica (apagada por defecto).
 */
import '@fontsource-variable/archivo/wdth.css';
import '@/styles/global.css';
import Encabezado from '@/components/Encabezado.astro';
import PiePagina from '@/components/PiePagina.astro';
import BotonWhatsApp from '@/components/BotonWhatsApp.astro';
import { marca } from '@/config/marca';
import { urlAbsoluta } from '@/lib/seo';

interface Props {
  /** Título de la página (sin el nombre de la marca). */
  titulo: string;
  descripcion: string;
  /** Imagen Open Graph (ruta relativa). */
  imagen?: string;
  /** No indexar (p. ej. confirmaciones, seguimiento). */
  noIndexar?: boolean;
  /** Datos estructurados JSON-LD adicionales. */
  jsonLd?: Record<string, unknown>[];
  /** Mensaje prellenado del botón de WhatsApp para esta página. */
  mensajeWhatsApp?: string;
  /** Identificador de la página para analítica. */
  pagina?: string;
  tipoOg?: 'website' | 'article' | 'product';
}

const {
  titulo,
  descripcion,
  imagen = marca.seo.imagenOg,
  noIndexar = false,
  jsonLd = [],
  mensajeWhatsApp = `Hola ${marca.nombre}, vi su página y quiero hacer una consulta.`,
  pagina = Astro.url.pathname,
  tipoOg = 'website',
} = Astro.props;

const tituloCompleto = titulo.includes(marca.nombre) ? titulo : `${titulo} | ${marca.nombre}`;
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonica = urlAbsoluta(ruta, Astro.site);
const imagenAbsoluta = urlAbsoluta(imagen, Astro.site);
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {noIndexar && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={marca.seo.colorTema} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={tipoOg} />
    <meta property="og:site_name" content={marca.nombre} />
    <meta property="og:locale" content={marca.seo.locale} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenAbsoluta} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="CO-CUN" />
    <meta name="geo.placename" content={marca.ubicacion.ciudad} />

    {jsonLd.map((d) => <script type="application/ld+json" is:inline set:html={JSON.stringify(d)} />)}
    <slot name="head" />
  </head>
  <body data-pagina={pagina}>
    <a href="#contenido" class="saltar">Saltar al contenido</a>
    <Encabezado>
      <slot name="cabecera" />
    </Encabezado>
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <PiePagina />
    <BotonWhatsApp mensaje={mensajeWhatsApp} origen={pagina} />

    <script>
      import { iniciarAnalitica, registrarEvento, type EventoConversion } from '@/lib/cliente/analitica';
      import { capturarOrigen } from '@/lib/cliente/origen';

      capturarOrigen();
      iniciarAnalitica();

      // Cualquier elemento con data-evento registra un evento de conversión al hacer clic.
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement | null)?.closest<HTMLElement>('[data-evento]');
        if (!el) return;
        registrarEvento(el.dataset.evento as EventoConversion, {
          origen: el.dataset.origen ?? document.body.dataset.pagina,
        });
      });
    </script>
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
