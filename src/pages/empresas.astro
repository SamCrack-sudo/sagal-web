---
import Base from '@/layouts/Base.astro';
import CabeceraPagina from '@/components/CabeceraPagina.astro';
import Faq from '@/components/Faq.astro';
import Icono from '@/components/Icono.astro';
import FormularioSolicitud from '@/components/islas/FormularioSolicitud';
import { marca } from '@/config/marca';
import { migas, paginaFaq, servicio, type PreguntaFrecuente } from '@/lib/seo';

const soluciones = [
  {
    icono: 'repuesto',
    titulo: 'Repuestos de mantenimiento',
    texto: 'Piezas plásticas que se desgastan o se rompen: engranajes, bujes, guías, soportes, tapas. Las tienes en días, no en semanas de importación.',
  },
  {
    icono: 'cad',
    titulo: 'Ingeniería inversa de piezas descontinuadas',
    texto: 'Medimos la pieza original, la modelamos en CAD y la mejoramos si hace falta. El archivo queda para futuras reposiciones.',
  },
  {
    icono: 'empresa',
    titulo: 'Jigs, fixtures y herramentales',
    texto: 'Plantillas de montaje, posicionadores y guías de control que reducen errores y tiempos en línea.',
  },
  {
    icono: 'electronica',
    titulo: 'Guardas y protecciones',
    texto: 'Cubiertas, carcasas y guardas a la medida para sensores, tableros y partes en movimiento.',
  },
  {
    icono: 'impresion',
    titulo: 'Prototipos y series cortas',
    texto: 'Valida un diseño antes de pedir un molde, o produce series cortas sin inversión en herramental.',
  },
] as const;

const preguntas: PreguntaFrecuente[] = [
  {
    pregunta: '¿Qué tan resistentes son las piezas impresas para uso industrial?',
    respuesta:
      'Depende del material y de cómo se diseñe y oriente la pieza. Para cada caso evaluamos temperatura, carga, químicos y desgaste, y te decimos con claridad si la impresión 3D es la opción adecuada o si conviene otro proceso.',
  },
  {
    pregunta: '¿Firman acuerdos de confidencialidad?',
    respuesta: 'Sí, podemos firmar un acuerdo de confidencialidad antes de recibir planos o piezas. [CONFIGURAR: modelo de acuerdo]',
  },
  {
    pregunta: '¿Emiten factura electrónica?',
    respuesta: '[CONFIGURAR: confirma si emites factura electrónica y bajo qué régimen tributario]',
  },
  {
    pregunta: '¿Pueden venir a la planta a tomar medidas?',
    respuesta: `Atendemos empresas en ${marca.ubicacion.areaServicio.join(', ')}. [CONFIGURAR: condiciones de visitas técnicas]`,
  },
];

const jsonLd = [
  servicio(
    {
      nombre: 'Repuestos y piezas impresas en 3D para empresas',
      descripcion: 'Repuestos de mantenimiento, ingeniería inversa, jigs, fixtures, guardas y prototipos para la industria.',
      ruta: '/empresas',
      tipo: 'Fabricación de repuestos industriales',
    },
    Astro.site,
  ),
  paginaFaq(preguntas),
  migas([{ nombre: 'Empresas', ruta: '/empresas' }], Astro.site),
];
---

<Base
  titulo="Repuestos impresos en 3D para empresas en Bogotá y la Sabana"
  descripcion={`Repuestos de mantenimiento, ingeniería inversa de piezas descontinuadas, jigs, fixtures y guardas impresos en 3D. Taller en ${marca.ubicacion.ciudad}, cerca de las zonas industriales de la Sabana y Bogotá.`}
  mensajeWhatsApp={`Hola ${marca.nombre}, escribo de una empresa y necesito un repuesto o una pieza.`}
  pagina="empresas"
  jsonLd={jsonLd}
>
  <CabeceraPagina
    slot="cabecera"
    rotulo="Empresas e industria"
    titulo="El repuesto que detiene tu línea, en días y no en semanas"
    entrada="Repuestos de mantenimiento, ingeniería inversa de piezas descontinuadas, jigs, fixtures y guardas. Con criterio de mantenimiento industrial, no solo de impresión."
    migas={[{ nombre: 'Empresas', ruta: '/empresas' }]}
  >
    <div class="grupo-botones">
      <a href="#solicitud" class="boton boton--primario">Enviar una solicitud</a>
      <a href="/cotizar" class="boton boton--claro">Ya tengo el archivo 3D</a>
    </div>
  </CabeceraPagina>

  <section class="seccion" aria-labelledby="soluciones-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <p class="rotulo">Qué resolvemos</p>
        <h2 class="titulo-2" id="soluciones-titulo">Piezas para mantenimiento y producción</h2>
        <p class="entrada">
          Entendemos el costo de una máquina parada: experiencia en análisis de procesos industriales y en coordinación de mantenimiento en planta.
        </p>
      </div>
      <div class="soluciones">
        {
          soluciones.map((s) => (
            <article class="item-linea solucion">
              <span class="item-linea__icono">
                <Icono nombre={s.icono} />
              </span>
              <div>
                <h3 class="titulo-3">{s.titulo}</h3>
                <p class="secundario">{s.texto}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="seccion seccion--alterna" aria-labelledby="como-titulo">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <p class="rotulo">Cómo trabajamos con empresas</p>
        <h2 class="titulo-2" id="como-titulo">Del problema en planta a la pieza instalada</h2>
      </div>
      <ol class="pasos">
        <li class="item-linea item-linea--fuerte">
          <span class="pasos__numero">1</span>
          <h3 class="titulo-4">Diagnóstico</h3>
          <p>Nos envías fotos, planos o la pieza. Revisamos el uso, la carga y el ambiente de trabajo.</p>
        </li>
        <li class="item-linea item-linea--fuerte">
          <span class="pasos__numero">2</span>
          <h3 class="titulo-4">Propuesta técnica</h3>
          <p>Material, método y plazo, con una cotización formal. Si la impresión no es la mejor opción, te lo decimos.</p>
        </li>
        <li class="item-linea item-linea--fuerte">
          <span class="pasos__numero">3</span>
          <h3 class="titulo-4">Primera pieza y ajuste</h3>
          <p>Fabricamos una primera pieza para validar el ajuste antes de la serie.</p>
        </li>
        <li class="item-linea item-linea--fuerte">
          <span class="pasos__numero">4</span>
          <h3 class="titulo-4">Reposición</h3>
          <p>Guardamos el diseño para reponer la pieza cuando la necesites, sin volver a empezar.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="seccion" id="solicitud" aria-labelledby="solicitud-titulo">
    <div class="contenedor dos-columnas">
      <div class="dos-columnas__texto solicitud__texto">
        <p class="rotulo">Solicitud empresarial</p>
        <h2 class="titulo-2" id="solicitud-titulo">Cuéntanos qué pieza necesitas</h2>
        <p class="entrada">Mientras más información técnica nos des, más rápida y precisa es la cotización.</p>
        <ul class="lista-marcas">
          <li>Fotos de la pieza junto a una regla o calibrador.</li>
          <li>Plano o archivo CAD, si existe.</li>
          <li>Equipo donde trabaja, temperatura y químicos a los que está expuesta.</li>
          <li>Cantidad y para cuándo la necesitas.</li>
        </ul>
        <p class="secundario">Los datos de facturación son opcionales: puedes enviarlos ahora o al aprobar la cotización.</p>
      </div>
      <div class="marco">
        <FormularioSolicitud client:visible variante="empresa" />
      </div>
    </div>
  </section>

  <section class="seccion seccion--alterna" aria-labelledby="faq-titulo">
    <div class="contenedor contenedor--estrecho">
      <div class="cabecera-seccion">
        <h2 class="titulo-2" id="faq-titulo">Preguntas de empresas</h2>
      </div>
      <Faq preguntas={preguntas} />
    </div>
  </section>
</Base>

<style>
  .soluciones {
    display: grid;
    gap: 0 64px;
  }

  @media (min-width: 880px) {
    .soluciones {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .solucion {
    display: flex;
    gap: 24px;
  }

  .solucion .item-linea__icono {
    flex: none;
    margin: 0;
  }

  .solucion > div {
    display: grid;
    gap: 8px;
  }

  @media (max-width: 480px) {
    .solucion {
      flex-direction: column;
      gap: 12px;
    }
  }

  @media (min-width: 960px) {
    .solicitud__texto {
      position: sticky;
      top: 24px;
    }
  }
</style>
