---
/**
 * Botón flotante de WhatsApp con mensaje contextual: cada página pasa su propio
 * texto prellenado. Si el número aún es un marcador, no se muestra (no hay a
 * quién escribir); en su lugar el sitio ofrece el correo y los formularios.
 */
import { enlaceWhatsApp } from '@/config/marca';

interface Props {
  mensaje: string;
  origen: string;
}

const { mensaje, origen } = Astro.props;
const href = enlaceWhatsApp(mensaje);
---

{
  href && (
    <a
      class="whatsapp"
      href={href}
      target="_blank"
      rel="noopener"
      data-evento="clic_whatsapp"
      data-origen={origen}
    >
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 4.54 0 8.23 3.7 8.23 8.24 0 4.54-3.69 8.24-8.23 8.24Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.29Z" />
      </svg>
      <span>WhatsApp</span>
    </a>
  )
}

<style>
  .whatsapp {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 18px 0 14px;
    border: 1px solid var(--c-linea-azul);
    border-radius: var(--radio);
    background: var(--c-texto-fuerte);
    color: var(--c-sobre-azul);
    font-weight: 650;
    box-shadow: 0 6px 20px rgba(6, 14, 28, 0.25);
  }

  .whatsapp svg {
    color: #25d366;
  }

  .whatsapp:hover {
    text-decoration: none;
    background: var(--c-azul);
  }

  @media (max-width: 480px) {
    .whatsapp span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
    }
    .whatsapp {
      padding: 0 14px;
    }
  }

  @media print {
    .whatsapp {
      display: none;
    }
  }
</style>
