---
/**
 * Logotipo: símbolo (mira de plano técnico) + nombre desde src/config/marca.ts.
 * Si cambia la marca, cambia el texto automáticamente; el símbolo vive aquí.
 */
import { marca } from '@/config/marca';

interface Props {
  tamano?: number;
  tono?: 'claro' | 'oscuro';
  soloSimbolo?: boolean;
}

const { tamano = 32, tono = 'claro', soloSimbolo = false } = Astro.props;
const trazo = tono === 'claro' ? '#E9EEF5' : '#16325C';
---

<span class="logo" data-tono={tono}>
  <svg width={tamano} height={tamano} viewBox="0 0 32 32" aria-hidden="true" fill="none">
    <rect x="1" y="1" width="30" height="30" rx="2" stroke={trazo} stroke-width="1.5"></rect>
    <circle cx="16" cy="16" r="7" stroke="#FF6A13" stroke-width="2.5"></circle>
    <path d="M16 4V10M16 22V28M4 16H10M22 16H28" stroke={trazo} stroke-width="1.5"></path>
  </svg>
  {
    !soloSimbolo && (
      <span class="logo__texto">
        {marca.nombreFuerte} <span class="logo__suave">{marca.nombreSuave}</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }
  .logo svg {
    flex: none;
  }
  .logo__texto {
    font-size: 20px;
    line-height: 1;
    font-weight: 750;
    font-stretch: 120%;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .logo__suave {
    font-weight: 400;
  }
  .logo[data-tono='claro'] {
    color: var(--c-sobre-azul);
  }
  .logo[data-tono='oscuro'] {
    color: var(--c-texto-fuerte);
  }
</style>
