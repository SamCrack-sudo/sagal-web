---
import Logo from './Logo.astro';
import { marca, enlaceInstagram, enlaceWhatsApp, esMarcador } from '@/config/marca';
import { servicios, navegacionPrincipal, enlacesLegales } from '@/config/navegacion';

const instagram = enlaceInstagram();
const whatsapp = enlaceWhatsApp(`Hola ${marca.nombre}, quiero hacer una consulta.`);
const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor pie__rejilla">
    <div class="pie__marca">
      <a href="/" aria-label={`${marca.nombre}, inicio`}><Logo tamano={28} /></a>
      <p>{marca.descripcionCorta}</p>
      <p class="pie__ubicacion">
        {marca.ubicacion.ciudad}, {marca.ubicacion.region} · {marca.ubicacion.zona}, cerca de Bogotá
      </p>
    </div>

    <nav aria-label="Servicios">
      <h2 class="pie__titulo">Servicios</h2>
      <ul>
        <li><a href="/cotizar">Cotizador de impresión 3D</a></li>
        {servicios.map((s) => <li><a href={s.href}>{s.etiqueta}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Empresa">
      <h2 class="pie__titulo">{marca.nombre}</h2>
      <ul>
        {navegacionPrincipal.map((e) => <li><a href={e.href}>{e.etiqueta}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="pie__titulo">Contacto</h2>
      <ul>
        <li><a href={`mailto:${marca.contacto.correo}`}>{marca.contacto.correo}</a></li>
        <li>
          {
            whatsapp ? (
              <a href={whatsapp} data-evento="clic_whatsapp" data-origen="pie">
                WhatsApp
              </a>
            ) : (
              <span>WhatsApp {marca.contacto.whatsapp}</span>
            )
          }
        </li>
        <li>
          {
            instagram ? (
              <a href={instagram} rel="noopener">
                Instagram @{marca.contacto.instagram}
              </a>
            ) : (
              <span>Instagram [@{marca.contacto.instagram.replace(/[[\]]/g, '')}]</span>
            )
          }
        </li>
        {!esMarcador(marca.ubicacion.horario) && <li>{marca.ubicacion.horario}</li>}
      </ul>
    </div>
  </div>

  <div class="contenedor pie__base">
    <span>© {anio} {marca.nombre}</span>
    <ul>
      {enlacesLegales.map((e) => <li><a href={e.href}>{e.etiqueta}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .pie {
    background: var(--c-azul);
    color: var(--c-sobre-azul-2);
    padding: 56px 0 32px;
    font-size: var(--f-pequeno);
  }

  .pie__rejilla {
    display: grid;
    gap: 40px 32px;
    padding-bottom: 40px;
  }

  @media (min-width: 720px) {
    .pie__rejilla {
      grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    }
  }

  .pie__marca {
    display: grid;
    gap: 14px;
    align-content: start;
    max-width: 30em;
  }

  .pie__marca a {
    justify-self: start;
  }

  .pie__marca a:hover {
    text-decoration: none;
  }

  .pie__ubicacion {
    color: var(--c-sobre-azul-3);
  }

  .pie__titulo {
    margin-bottom: 12px;
    color: var(--c-sobre-azul);
    font-size: var(--f-mini);
    font-weight: 700;
    font-stretch: var(--f-ancho-plano);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pie ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }

  .pie li > a,
  .pie li > span {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    overflow-wrap: anywhere;
  }

  .pie__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    padding-top: 24px;
    border-top: 1px solid var(--c-linea-azul);
  }

  .pie__base ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
  }
</style>
